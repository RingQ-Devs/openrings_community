{
  "name": "openrings-community",
  "version": "1.6.0",
  "private": true,
  "description": "OpenRings Community - Q&A forum answered by the RingQ Support team",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "init": "node scripts/init.js",
    "seed:today": "node scripts/seed-today.js",
    "doctor": "node scripts/doctor.js",
    "ai:setup": "node scripts/setup-openrings-ai.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@vercel/functions": "^3.11.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "marked": "^18.2.1",
    "openai": "^7.62.0",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.2",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  }
}
