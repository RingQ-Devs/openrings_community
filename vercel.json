{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 300, "includeFiles": "{views,seed,knowledge,src,public}/**" },
    "api/cron.js": { "maxDuration": 300, "includeFiles": "{views,seed,knowledge,src}/**" }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "* * * * *" }
  ]
}
