<%- include('partials/header') %>
<section class="error-page card">
  <p class="error-code"><%= status %></p>
  <h1><%= status === 404 ? 'Page not found' : status === 403 ? 'Not allowed' : status === 429 ? 'Slow down' : status === 401 ? 'Log in required' : 'Something went wrong' %></h1>
  <p class="muted"><%= message %></p>
  <div class="hero-actions">
    <a class="btn btn--primary" href="<%= url('/') %>">Back to forums</a>
    <% if (status === 401) { %><a class="btn btn--ghost" href="<%= url('/login') %>">Log in</a><% } %>
  </div>
</section>
<%- include('partials/footer') %>
