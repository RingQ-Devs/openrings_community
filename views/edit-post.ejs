<%- include('partials/header') %>
<div class="narrow">
  <nav class="breadcrumb"><a href="<%= url(fmt.threadPath(thread)) %>">‹ Back to “<%= thread.title %>”</a></nav>
  <h1>Edit post</h1>
  <% if (errors.length) { %><div class="alert alert--error"><%= errors.join(' ') %></div><% } %>
  <form class="card form" method="post" action="<%= url('/posts/' + post.id + '/edit') %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('partials/editor', { id: 'edit-body', rows: 14, value: post.body }) %>
    <div class="form-actions">
      <button class="btn btn--primary" type="submit">Save changes</button>
      <a class="btn btn--ghost" href="<%= url('/posts/' + post.id) %>">Cancel</a>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
