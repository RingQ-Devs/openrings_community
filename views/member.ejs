<%- include('partials/header') %>
<section class="profile card">
  <%- h.avatar(member, 96) %>
  <div class="profile-info">
    <h1><%= member.username %> <%- badges(member) %></h1>
    <p class="muted"><%= member.title || fmt.ROLE_LABELS[member.role] || 'Member' %><%= member.location ? ' · ' + member.location : '' %></p>
    <% if (member.bio) { %><p class="profile-bio"><%= member.bio %></p><% } %>
    <% if (member.website) { %><p><a href="<%= member.website %>" rel="nofollow ugc noopener" target="_blank"><%= member.website.replace(/^https?:\/\//, '') %></a></p><% } %>
    <% if (member.role === 'persona' && disclosePersonas) { %>
      <p class="small muted">This account posts sample questions that cover common <%= site.productName %> topics.</p>
    <% } %>
  </div>
  <dl class="profile-stats">
    <div><dt>Messages</dt><dd><%= member.post_count.toLocaleString('en-US') %></dd></div>
    <div><dt>Likes received</dt><dd><%= member.like_count.toLocaleString('en-US') %></dd></div>
    <% if (member.role !== 'ai') { %><div><dt>Joined</dt><dd><%= fmt.formatDate(member.created_at) %></dd></div><% } %>
    <% if (member.last_seen_at) { %><div><dt>Last seen</dt><dd><%= fmt.timeAgo(member.last_seen_at) %></dd></div><% } %>
  </dl>
  <% if (isStaff && persona) { %>
    <p class="small muted staff-note">Persona: <%= persona.job %> · <%= persona.organization %> · <%= persona.experience %> · <%= persona.writing_style %></p>
  <% } %>
</section>

<div class="layout">
  <div class="content">
    <section class="block">
      <header class="block-header"><h2>Recent posts</h2></header>
      <ul class="activity-list">
        <% posts.forEach(p => { %>
        <li>
          <a class="activity-title" href="<%= url('/posts/' + p.id) %>"><%= p.thread_title %></a>
          <p class="small"><%= p.excerpt %></p>
          <p class="muted small"><%= p.forum_title %> · <time datetime="<%= p.created_at %>"><%= fmt.timeAgo(p.created_at) %></time></p>
        </li>
        <% }) %>
        <% if (!posts.length) { %><li class="muted">No posts yet.</li><% } %>
      </ul>
    </section>
  </div>
  <aside class="sidebar">
    <section class="card">
      <h2 class="card-title">Threads started</h2>
      <ul class="mini-list mini-list--plain">
        <% threads.forEach(t => { %><li><a href="<%= url(fmt.threadPath(t)) %>"><%= t.title %></a><span class="muted small"><%= t.reply_count %> <%= t.reply_count === 1 ? 'reply' : 'replies' %></span></li><% }) %>
        <% if (!threads.length) { %><li class="muted small">None yet.</li><% } %>
      </ul>
    </section>
  </aside>
</div>
<%- include('partials/footer') %>
