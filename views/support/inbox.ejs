<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Support inbox</h1>
    <p class="muted">Draft replies waiting for review. Check each one, edit it if needed, and post it. It appears in the thread under the engineer you choose, with the <%= supportTeamName %> badge.</p>
  </div>
  <nav class="tabs" aria-label="Inbox view">
    <a class="tab<%= !mine ? ' is-active' : '' %>" href="<%= url('/support/inbox') %>">All drafts</a>
    <a class="tab<%= mine ? ' is-active' : '' %>" href="<%= url('/support/inbox?view=mine') %>">Assigned to me</a>
  </nav>
</div>

<% if (!drafts.length) { %>
  <div class="empty card"><p><%= mine ? 'Nothing assigned to you right now.' : 'No drafts are waiting.' %></p>
  <% if (mine) { %><a class="btn btn--ghost btn--sm" href="<%= url('/support/inbox') %>">See all drafts</a><% } %></div>
<% } %>

<div class="draft-list">
<% drafts.forEach(d => { %>
  <article class="card draft" id="draft-<%= d.id %>">
    <header class="draft-head">
      <a class="draft-title" href="<%= url('/threads/' + d.thread_slug + '.' + d.thread_id + '/') %>" target="_blank" rel="noopener"><%= d.thread_title %></a>
      <span class="muted small"><%= d.forum_title %> · <%= d.reply_count %> <%= d.reply_count === 1 ? 'reply' : 'replies' %> · drafted <%= fmt.timeAgo(d.updated_at) %><% if (d.assigned_username) { %> · assigned to <strong><%= d.assigned_username %></strong><% } %></span>
    </header>
    <div class="draft-context">
      <p class="small"><strong><%= d.first_username %>:</strong> <%= d.question %></p>
      <% if (d.latest) { %><p class="small"><strong>Latest, <%= d.reply_to_username %>:</strong> <%= d.latest %></p><% } %>
    </div>
    <form class="form" method="post" action="<%= url('/support/drafts/' + d.id) %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="view" value="<%= mine ? 'mine' : 'all' %>">
      <%- include('../partials/editor', { id: 'draft-body-' + d.id, rows: 10, value: d.body, placeholder: '' }) %>
      <div class="form-actions">
        <label class="inline-form small">Post as
          <select name="post_as">
            <% staff.forEach(s => { %><option value="<%= s.id %>" <%= s.id === (d.assigned_to || user.id) ? 'selected' : '' %>><%= s.username %><%= s.on_duty ? ' (on duty)' : '' %></option><% }) %>
          </select>
        </label>
        <button class="btn btn--primary btn--sm" type="submit" name="action" value="post">Post reply</button>
        <button class="btn btn--sm" type="submit" name="action" value="post_open">Post and open thread</button>
        <button class="btn btn--sm" type="submit" name="action" value="regenerate">Write a new draft</button>
        <button class="btn btn--sm btn--danger" type="submit" name="action" value="discard">Discard</button>
      </div>
    </form>
  </article>
<% }) %>
</div>

<% if (recent.length) { %>
<section class="card">
  <h2 class="card-title">Recently posted</h2>
  <ul class="mini-list mini-list--plain">
    <% recent.forEach(r => { %><li><a href="<%= url('/posts/' + r.post_id) %>"><%= r.thread_title %></a><span class="muted small">as <%= r.posted_as_username %>, reviewed by <%= r.reviewer_username %> · <%= fmt.timeAgo(r.updated_at) %></span></li><% }) %>
  </ul>
</section>
<% } %>
<%- include('../partials/footer') %>
