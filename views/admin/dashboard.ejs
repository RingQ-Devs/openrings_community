<%- include('../partials/header') %>
<div class="page-head"><h1>Admin dashboard</h1><span class="muted small">Version <%= version %></span></div>
<%- include('_nav') %>
<% if (creditProblem) { %>
<div class="alert alert--error"><strong>Claude API credit balance is too low.</strong> AI answers and daily posts are paused. In the <a href="https://platform.claude.com/">Claude Console</a> open <em>Plans &amp; Billing</em> and buy credits. Waiting jobs retry automatically every hour for a day; older failed jobs can be retried in <a href="<%= url('/admin/jobs') %>">AI activity</a>.</div>
<% } %>
<% if (!aiConfigured) { %>
<div class="alert alert--error">Drafts are <strong>off</strong>. Choose Claude or OpenAI and enter the API key in <a href="<%= url('/admin/ai') %>">AI provider</a>.</div>
<% } else { %>
<div class="alert alert--info">Answer writer: <strong><%= aiModel %></strong> · reply mode <strong><%= settings.reply_mode === 'auto' ? 'automatic (labelled “Automated”)' : settings.reply_mode === 'review_fallback' ? 'support review, automatic after ' + settings.review_fallback_minutes + ' min' : 'support review' %></strong> · answers <strong><%= settings.ai_autoreply_enabled === '1' ? 'on' : 'off' %></strong> · daily posts <strong><%= settings.seed_enabled === '1' ? settings.seed_posts_per_day + '/day' : 'off' %></strong><%= settings.seed_enabled === '1' && settings.seed_require_approval === '1' ? ' (need approval)' : '' %></div>
<% } %>
<% if (settings.reply_mode !== 'auto') { %>
<div class="alert <%= onDuty.length ? 'alert--info' : 'alert--error' %>">
  <strong>On duty:</strong> <%= onDuty.length ? onDuty.map(u => u.username).join(', ') : 'nobody. Drafts are assigned to any support engineer.' %>
  · <a href="<%= url('/admin/users') %>">Change the duty roster</a>
  · <a href="<%= url('/support/inbox') %>"><%= pendingDrafts %> draft<%= pendingDrafts === 1 ? '' : 's' %> waiting</a>
</div>
<% } %>
<div class="stat-grid">
  <div class="stat card"><span>Threads</span><strong><%= stats.threads %></strong></div>
  <div class="stat card"><span>Messages</span><strong><%= stats.posts %></strong></div>
  <div class="stat card"><span>Members</span><strong><%= stats.members %></strong></div>
  <div class="stat card"><span>Solved</span><strong><%= stats.solved %></strong></div>
  <div class="stat card"><span>Drafts waiting</span><strong><%= pendingDrafts %></strong><small class="muted"><a href="<%= url('/support/inbox') %>">Open Support inbox</a></small></div>
  <div class="stat card"><span>Answer jobs (24h)</span><strong><%= (jobs.done || 0) %></strong><small class="muted"><%= jobs.queued || 0 %> queued · <%= jobs.skipped || 0 %> skipped · <%= jobs.failed || 0 %> failed</small></div>
</div>
<div class="admin-grid">
  <section class="card">
    <h2 class="card-title">Daily posts (today: <%= today %>)</h2>
    <% if (queue.length) { %>
    <table class="table">
      <thead><tr><th>Time</th><th>Question</th><th>Persona</th><th>Status</th></tr></thead>
      <tbody>
      <% queue.forEach(q => { %>
        <tr><td class="nowrap"><%= fmt.formatDateTime(q.publish_at) %></td><td><%= q.title %><br><span class="muted small"><%= q.forum_title %></span></td><td><%= q.persona_username %></td><td><span class="status status--<%= q.status %>"><%= q.status %></span></td></tr>
      <% }) %>
      </tbody>
    </table>
    <% } else { %><p class="muted">Nothing planned yet. The scheduler plans a new batch each day, or you can <a href="<%= url('/admin/queue') %>">generate one now</a>.</p><% } %>
  </section>
  <section class="card">
    <h2 class="card-title">Newest members</h2>
    <ul class="mini-list">
      <% newMembers.forEach(m => { %><li><%- h.avatar(m, 28) %><div><%- h.userLink(url(''), m) %><span class="muted small"><%= m.email %> · <%= fmt.timeAgo(m.created_at) %></span></div></li><% }) %>
      <% if (!newMembers.length) { %><li class="muted">No registrations yet.</li><% } %>
    </ul>
    <% if (failed.length) { %>
    <h2 class="card-title">Recent failures</h2>
    <ul class="mini-list mini-list--plain">
      <% failed.forEach(j => { %><li><strong><%= j.type %></strong> #<%= j.id %><span class="muted small"><%= j.last_error %></span></li><% }) %>
    </ul>
    <% } %>
  </section>
</div>
<%- include('../partials/footer') %>
