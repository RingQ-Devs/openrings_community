<%- include('../partials/header') %>
<div class="page-head"><h1>Topic ideas</h1></div>
<%- include('_nav') %>
<p class="muted">One idea per line. The daily generator uses these ideas first, then removes each one it uses. When the list is empty, the AI picks topics for each forum. Add the questions you want the community to rank for in search.</p>
<form class="card form" method="post" action="<%= url('/admin/topics') %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <textarea name="topic_bank" rows="24"><%= topics %></textarea>
  <div class="form-actions"><button class="btn btn--primary" type="submit">Save topic ideas</button>
  <span class="muted small"><%= topics.split('\n').filter(Boolean).length %> ideas waiting</span></div>
</form>
<%- include('../partials/footer') %>
