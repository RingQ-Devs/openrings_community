<%- include('../partials/header') %>
<div class="page-head"><h1>Knowledge base</h1></div>
<%- include('_nav') %>
<div class="alert alert--info">
  Drafted answers take all <strong><%= site.productName %> product facts</strong> from this text: features, ports, requirements, commands and how-tos. Nothing missing from here is guessed.
  It is stored in the database and is never shown to visitors. Each new draft uses the saved text. Drafts already waiting in the Support inbox keep their old wording; use <em>Write a new draft</em> there to refresh one.
</div>
<form class="card form" method="post" action="<%= url('/admin/knowledge') %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <textarea class="mono" name="knowledge_base" rows="34"><%= knowledge %></textarea>
  <div class="form-actions">
    <button class="btn btn--primary" type="submit">Save knowledge base</button>
    <span class="muted small"><%= knowledge.length.toLocaleString('en-US') %> characters<%= savedAt ? ' · last saved ' + fmt.formatDateTime(savedAt) : '' %></span>
  </div>
</form>
<% if (backup) { %>
<details class="card">
  <summary class="small">Previous version, kept from the <%= fmt.formatDate(backupAt) %> update (read only, for copying)</summary>
  <p class="muted small">On <%= fmt.formatDate(backupAt) %> the old starter template was replaced with the version filled from openrings.org. Lines you had added were kept under “Added in the admin panel”. The full previous text is below if you need anything else from it.</p>
  <textarea class="mono" rows="16" readonly><%= backup %></textarea>
</details>
<% } %>
<%- include('../partials/footer') %>
