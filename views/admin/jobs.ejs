<%- include('../partials/header') %>
<div class="page-head"><h1>AI activity</h1></div>
<%- include('_nav') %>
<div class="table-wrap card">
<table class="table">
  <thead><tr><th>#</th><th>Type</th><th>Status</th><th>Run at</th><th>Details</th><th></th></tr></thead>
  <tbody>
  <% jobs.forEach(j => { %>
  <tr>
    <td><%= j.id %></td>
    <td><%= j.type %></td>
    <td><span class="status status--<%= j.status %>"><%= j.status %></span><% if (j.attempts > 1) { %><br><span class="muted small"><%= j.attempts %> attempts</span><% } %></td>
    <td class="nowrap small"><%= fmt.formatDateTime(j.run_at) %></td>
    <td class="small">
      <% if (j.payloadObj.threadId) { %><a href="<%= url('/threads/x.' + j.payloadObj.threadId + '/') %>">thread <%= j.payloadObj.threadId %></a><% } %>
      <% if (j.payloadObj.count) { %><%= j.payloadObj.count %> questions<% } %>
      <% if (j.resultObj) { %>
        <% if (j.resultObj.reason) { %> · <%= j.resultObj.reason %><% } %>
        <% if (j.resultObj.created !== undefined) { %> · created <%= j.resultObj.created %> (<%= j.resultObj.status %>)<% } %>
        <% if (j.resultObj.usage) { %> · <span class="muted"><%= j.resultObj.model %>, <%= j.resultObj.usage.input_tokens %> in / <%= j.resultObj.usage.output_tokens %> out<%= j.resultObj.usage.cache_read_input_tokens ? ', ' + j.resultObj.usage.cache_read_input_tokens + ' cached' : '' %></span><% } %>
      <% } %>
      <% if (j.last_error) { %><div class="error-text"><%= j.last_error %></div><% } %>
    </td>
    <td><% if (j.status === 'failed' || j.status === 'skipped') { %>
      <form method="post" action="<%= url('/admin/jobs/' + j.id + '/retry') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm" type="submit">Retry</button></form>
    <% } %></td>
  </tr>
  <% }) %>
  </tbody>
</table>
<% if (!jobs.length) { %><p class="muted">No AI activity yet.</p><% } %>
</div>
<%- include('../partials/footer') %>
