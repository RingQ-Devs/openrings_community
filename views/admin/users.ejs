<%- include('../partials/header') %>
<div class="page-head"><h1>Users & staff</h1></div>
<%- include('_nav') %>
<div class="admin-grid admin-grid--wide">
  <section class="card">
    <h2 class="card-title">Add a support engineer or admin account</h2>
    <% if (errors.length) { %><div class="alert alert--error"><%= errors.join(' ') %></div><% } %>
    <form class="form" method="post" action="<%= url('/admin/users') %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field-row">
        <label class="field"><span>Username</span><input type="text" name="username" value="<%= values.username || '' %>" required></label>
        <label class="field"><span>Email</span><input type="email" name="email" value="<%= values.email || '' %>" required></label>
      </div>
      <div class="field-row">
        <label class="field"><span>Password</span><input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
        <label class="field"><span>Role</span><select name="role"><option value="support">Support engineer</option><option value="admin">Admin</option><option value="member">Member</option></select></label>
        <label class="field"><span>Title</span><input type="text" name="title" placeholder="Support Engineer"></label>
      </div>
      <button class="btn btn--primary btn--sm" type="submit">Create account</button>
    </form>
  </section>
  <section class="card">
    <h2 class="card-title">Find users</h2>
    <form class="inline-form" method="get" action="<%= url('/admin/users') %>">
      <input type="search" name="q" value="<%= q %>" placeholder="Username or email">
      <button class="btn btn--sm" type="submit">Search</button>
    </form>
    <p class="muted small">Support engineers and admins carry the <strong><%= supportTeamName %></strong> badge on every post. They review drafts in the Support inbox, and can pin, lock, move and delete threads. Tick <strong>On duty</strong> for the engineers who should receive new drafts. Each draft goes to one of them at random.</p>
  </section>
</div>
<div class="table-wrap card">
<table class="table">
  <thead><tr><th>User</th><th>Email</th><th>Joined</th><th>Posts</th><th>Role · title · duty · status</th></tr></thead>
  <tbody>
  <% users.forEach(u => { %>
  <tr class="<%= u.is_banned ? 'is-muted' : '' %>">
    <td class="nowrap"><%- h.avatar(u, 26) %> <%- h.userLink(url(''), u) %> <%- h.badges(u, true, supportTeamName) %></td>
    <td><%= u.email || '—' %></td>
    <td class="nowrap"><%= fmt.formatDate(u.created_at) %></td>
    <td><%= u.post_count %></td>
    <td>
      <% if (u.role !== 'ai' && u.role !== 'persona') { %>
      <form class="inline-form" method="post" action="<%= url('/admin/users/' + u.id) %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="q" value="<%= q %>">
        <select name="role" aria-label="Role"><% ['member', 'support', 'admin'].forEach(r => { %><option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= fmt.ROLE_LABELS[r] %></option><% }) %></select>
        <input type="text" name="title" value="<%= u.title || '' %>" placeholder="Title" aria-label="Title" class="input-sm">
        <% if (u.role === 'support' || u.role === 'admin') { %><label class="check small" title="On-duty engineers get new draft replies, picked at random"><input type="checkbox" name="on_duty" value="1" <%= u.on_duty ? 'checked' : '' %>> On duty</label><% } %>
        <label class="check small"><input type="checkbox" name="is_banned" value="1" <%= u.is_banned ? 'checked' : '' %>> Banned</label>
        <button class="btn btn--sm" type="submit">Save</button>
      </form>
      <% } else { %><span class="muted small"><%= fmt.ROLE_LABELS[u.role] %></span><% } %>
    </td>
  </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>
