<%- include('../partials/header') %>
<div class="page-head"><h1>AI provider</h1></div>
<%- include('_nav') %>
<div class="alert <%= ready ? 'alert--success' : ai.provider === 'none' ? 'alert--info' : 'alert--error' %>">
  Drafts are written by: <strong><%= active %></strong><%= ready || ai.provider === 'none' ? '' : ' (missing key or settings, so drafts are off)' %>.
  <% if (ai.providerSource === 'env') { %><span class="muted small">Currently taken from the <code>.env</code> file. Saving here overrides it.</span><% } %>
</div>
<% if (results) { %>
<div class="card">
  <h2 class="card-title">Last connection test · <%= fmt.timeAgo(results.at) %></h2>
  <ul class="check-list">
    <% results.results.forEach(r => { %>
      <li class="<%= r.ok === true ? 'is-ok' : r.ok === false ? 'is-bad' : 'is-warn' %>">
        <strong><%= r.ok === true ? 'OK' : r.ok === false ? 'Failed' : 'Note' %>:</strong> <%= r.message %>
        <% if (r.fix) { %><div class="muted small"><%= r.fix %></div><% } %>
      </li>
    <% }) %>
  </ul>
</div>
<% } %>
<%
  const keyNote = (p) => {
    const k = ai[p];
    if (k.keyUnreadable) return 'The saved key cannot be read on this server (the encryption key changed). Enter it again.';
    if (k.keySource === 'admin') return 'Saved key: ' + keys[p] + '. Leave the field empty to keep it.';
    if (k.keySource === 'env') return 'Using the key from .env (' + keys[p] + '). Enter one here to override it.';
    return 'No key saved yet.';
  };
  const show = (p) => ai.provider === p ? '' : ' hidden';
%>
<form class="card form" method="post" action="<%= url('/admin/ai') %>" autocomplete="off" data-provider-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <label class="field" style="max-width:460px"><span>AI provider</span>
    <select name="provider" data-provider-select>
      <option value="anthropic" <%= ai.provider === 'anthropic' ? 'selected' : '' %>>Claude (Anthropic): API key</option>
      <option value="openai" <%= ai.provider === 'openai' ? 'selected' : '' %>>OpenAI: API key</option>
      <option value="local" <%= ai.provider === 'local' ? 'selected' : '' %>>Open Rings AI: self-hosted, no API key</option>
      <option value="mock" <%= ai.provider === 'mock' ? 'selected' : '' %>>Demo text: for testing, no AI</option>
      <option value="none" <%= ai.provider === 'none' ? 'selected' : '' %>>Off: no drafts, no daily posts</option>
    </select>
  </label>

  <fieldset class="provider-section" data-provider-section="anthropic"<%= show('anthropic') %>>
    <legend>Claude settings</legend>
    <label class="field"><span>API key</span>
      <input type="password" name="anthropic_api_key" placeholder="sk-ant-api03-…" autocomplete="new-password" spellcheck="false">
      <small class="muted"><%= keyNote('anthropic') %> Get a key at <a href="https://platform.claude.com/settings/keys" target="_blank" rel="noopener">platform.claude.com/settings/keys</a>.</small>
    </label>
    <% if (ai.anthropic.keySource === 'admin') { %><label class="check small"><input type="checkbox" name="anthropic_remove_key" value="1"> Remove the saved Claude key</label><% } %>
    <div class="field-row">
      <label class="field"><span>Model</span><input type="text" name="anthropic_model" value="<%= ai.anthropic.model === defaults.model ? '' : ai.anthropic.model %>" placeholder="<%= defaults.model %>"></label>
      <label class="field"><span>Effort</span>
        <select name="anthropic_effort"><% claudeEfforts.forEach(e => { %><option value="<%= e %>" <%= ai.anthropic.effort === e ? 'selected' : '' %>><%= e %></option><% }) %></select>
      </label>
    </div>
  </fieldset>

  <fieldset class="provider-section" data-provider-section="openai"<%= show('openai') %>>
    <legend>OpenAI settings</legend>
    <label class="field"><span>API key</span>
      <input type="password" name="openai_api_key" placeholder="sk-…" autocomplete="new-password" spellcheck="false">
      <small class="muted"><%= keyNote('openai') %> Get a key at <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener">platform.openai.com/api-keys</a>.</small>
    </label>
    <% if (ai.openai.keySource === 'admin') { %><label class="check small"><input type="checkbox" name="openai_remove_key" value="1"> Remove the saved OpenAI key</label><% } %>
    <div class="field-row">
      <label class="field"><span>Model</span><input type="text" name="openai_model" value="<%= ai.openai.model === defaults.openaiModel ? '' : ai.openai.model %>" placeholder="<%= defaults.openaiModel %>"></label>
      <label class="field"><span>Reasoning effort (reasoning models only)</span>
        <select name="openai_reasoning_effort"><% openaiEfforts.forEach(e => { %><option value="<%= e %>" <%= (ai.openai.reasoningEffort || 'default') === e ? 'selected' : '' %>><%= e === 'default' ? 'model default' : e %></option><% }) %></select>
      </label>
    </div>
  </fieldset>

  <fieldset class="provider-section" data-provider-section="local"<%= show('local') %>>
    <legend>Open Rings AI (self-hosted)</legend>
    <p class="muted small">Open Rings AI runs on your own machine: no API key and no per-use cost. Answers are slower and simpler than Claude or OpenAI. It needs about 8 GB of free memory and 6 GB of disk space.</p>
    <div class="setup-box">
      <p><strong>Set it up once</strong> on the machine that runs the forum. In the forum folder, run:</p>
      <p class="small">Windows (Command Prompt):</p>
      <pre><code>npm run ai:setup</code></pre>
      <p class="small">Linux:</p>
      <pre><code>sudo node scripts/setup-openrings-ai.js</code></pre>
      <p class="muted small">It installs the Open Rings AI engine, downloads the model (about 5 GB, first time only), tests it and selects it here. Then click <em>Save and test connection</em>.</p>
    </div>
    <div class="field-row">
      <label class="field"><span>Engine address</span><input type="url" name="local_base_url" value="<%= ai.local.baseUrl === defaults.local.baseUrl ? '' : ai.local.baseUrl %>" placeholder="<%= defaults.local.baseUrl %>"><small class="muted">Leave empty when the engine runs on this machine.</small></label>
      <label class="field"><span>Model name</span><input type="text" name="local_model" value="<%= ai.local.model === defaults.local.model ? '' : ai.local.model %>" placeholder="<%= defaults.local.model %>"><small class="muted">Leave empty to use <code><%= defaults.local.model %></code>.</small></label>
    </div>
    <label class="field"><span>API key (only if the engine is behind a server that requires one)</span>
      <input type="password" name="local_api_key" autocomplete="new-password" spellcheck="false">
      <small class="muted"><%= keyNote('local') %> Not needed for the Open Rings AI engine.</small>
    </label>
    <% if (ai.local.keySource === 'admin') { %><label class="check small"><input type="checkbox" name="local_remove_key" value="1"> Remove the saved key</label><% } %>
  </fieldset>

  <p class="muted small provider-section" data-provider-section="mock"<%= show('mock') %>>Demo text: drafts are clearly marked test text. Use this to try the Support inbox without any AI.</p>
  <p class="muted small provider-section" data-provider-section="none"<%= show('none') %>>Off: no drafts and no daily posts. The forum itself keeps working.</p>

  <p class="muted small">Keys are stored encrypted in the database and are never shown again in full. Each provider keeps its own settings, so you can switch back and forth. Changes apply immediately. The test makes one tiny request to check the connection.</p>
  <div class="form-actions">
    <button class="btn btn--primary" type="submit" name="action" value="save">Save</button>
    <button class="btn" type="submit" name="action" value="test">Save and test connection</button>
  </div>
</form>
<%- include('../partials/footer') %>
