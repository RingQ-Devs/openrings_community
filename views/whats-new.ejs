<%- include('partials/header') %>
<div class="page-head">
  <div>
    <h1><%= unanswered ? 'Unanswered questions' : "What's new" %></h1>
    <p class="muted"><%= unanswered ? 'Questions still waiting for a reply. Can you help?' : 'The latest activity across all forums.' %></p>
  </div>
  <div class="tabs">
    <a class="tab<%= !unanswered ? ' is-active' : '' %>" href="<%= url('/whats-new') %>">Latest</a>
    <a class="tab<%= unanswered ? ' is-active' : '' %>" href="<%= url('/whats-new?filter=unanswered') %>">Unanswered</a>
  </div>
</div>
<div class="layout">
  <div class="content">
    <section class="block">
      <% if (threads.length) { %>
      <ul class="thread-list">
        <% threads.forEach(t => { %><%- include('partials/thread-row', { t, showForum: true }) %><% }) %>
      </ul>
      <% } else { %><div class="empty"><p>Nothing here right now.</p></div><% } %>
    </section>
    <%- include('partials/pagination', { base: url('/whats-new' + (unanswered ? '?filter=unanswered' : '')) }) %>
  </div>
  <%- include('partials/sidebar') %>
</div>
<%- include('partials/footer') %>
