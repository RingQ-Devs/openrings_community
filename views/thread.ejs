<%- include('partials/header') %>
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="<%= url('/') %>">Forums</a> <span>›</span> <span><%= category.title %></span> <span>›</span>
  <a href="<%= url('/forums/' + forum.slug + '/') %>"><%= forum.title %></a>
</nav>

<header class="thread-head">
  <div class="thread-head-flags">
    <% if (thread.deleted_at) { %><span class="label label--danger">Deleted</span><% } %>
    <% if (thread.is_solved) { %><span class="label label--solved"><%- icon('check', 12) %> Solved</span><% } %>
    <% if (thread.is_pinned) { %><span class="label"><%- icon('pin', 12) %> Pinned</span><% } %>
    <% if (thread.is_locked) { %><span class="label"><%- icon('lock', 12) %> Locked</span><% } %>
  </div>
  <h1><%= thread.title %></h1>
  <p class="muted small thread-head-meta">
    Started by <%- h.userLink(url(''), { username: thread.author_username, role: thread.author_role }) %>
    · <time datetime="<%= thread.created_at %>"><%= fmt.formatDate(thread.created_at) %></time>
    · <%- icon('reply', 14) %> <span data-reply-count><%= thread.reply_count %> <%= thread.reply_count === 1 ? 'reply' : 'replies' %></span>
    · <%- icon('eye', 14) %> <%= fmt.compactNumber(thread.view_count) %> views
  </p>
</header>

<% if (isStaff) { %>
<details class="mod-bar card">
  <summary><%- icon('settings', 16) %> Staff tools <span class="muted small">— draft replies are <strong><%= thread.ai_enabled ? 'on' : 'off' %></strong> for this thread</span></summary>
  <div class="mod-actions">
    <% const act = (action, label, extra = '') => `<form method="post" action="${url('/threads/' + thread.id + '/moderate')}"><input type="hidden" name="_csrf" value="${csrfToken}"><input type="hidden" name="action" value="${action}"><button class="btn btn--sm ${extra}" type="submit">${label}</button></form>`; %>
    <%- act(thread.is_pinned ? 'unpin' : 'pin', thread.is_pinned ? 'Unpin' : 'Pin') %>
    <%- act(thread.is_locked ? 'unlock' : 'lock', thread.is_locked ? 'Unlock' : 'Lock') %>
    <%- act(thread.ai_enabled ? 'ai_off' : 'ai_on', thread.ai_enabled ? 'Turn drafts off' : 'Turn drafts on') %>
    <% if (aiOn) { %><%- act('ai_reply_now', 'Generate draft reply', 'btn--draft') %><% } %>
    <form method="post" action="<%= url('/threads/' + thread.id + '/moderate') %>" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="move">
      <select name="forum_id" aria-label="Move to forum">
        <% allForums.forEach(f => { %><option value="<%= f.id %>" <%= f.id === thread.forum_id ? 'selected' : '' %>><%= f.title %></option><% }) %>
      </select>
      <button class="btn btn--sm" type="submit">Move</button>
    </form>
    <form method="post" action="<%= url('/threads/' + thread.id + '/moderate') %>" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="rename">
      <input type="text" name="title" value="<%= thread.title %>" aria-label="Thread title" minlength="8" maxlength="150">
      <button class="btn btn--sm" type="submit">Rename</button>
    </form>
    <form method="post" action="<%= url('/threads/' + thread.id + '/moderate') %>" data-confirm="Delete this entire thread?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="delete">
      <button class="btn btn--sm btn--danger" type="submit">Delete thread</button>
    </form>
  </div>
</details>
<% } %>
<% if (isStaff && pendingDraft) { %>
<div class="alert alert--info staff-only">A draft reply for this thread is waiting<%= pendingDraft.assigned_username ? ' for ' + pendingDraft.assigned_username : '' %>. <a href="<%= url('/support/inbox#draft-' + pendingDraft.id) %>">Review it in the Support inbox</a></div>
<% } %>

<div class="layout">
  <div class="content">
    <% if (solution && page === 1) { %>
    <section class="solution-box">
      <div class="solution-head"><%- icon('check', 16) %> Solution</div>
      <p><%= solution.excerpt %></p>
      <a href="<%= url(fmt.threadPath(thread) + (solution.page > 1 ? '?page=' + solution.page : '') + '#post-' + solution.id) %>">Jump to the solution ›</a>
    </section>
    <% } %>

    <%- include('partials/pagination', { base: url(fmt.threadPath(thread)) }) %>

    <div class="posts" data-posts<%- page === pages ? ` data-live data-thread-id="${thread.id}" data-last-post="${posts.length ? posts[posts.length - 1].id : 0}"` : '' %>>
    <% posts.forEach((p, idx) => { %>
      <%- include('partials/post', { p, number: (page - 1) * 20 + idx + 1 }) %>
    <% }) %>
    </div>
    <p class="live-status" data-live-status aria-live="polite" hidden><span class="dot-pulse"></span> <span data-live-text>A reply is being prepared…</span></p>

    <%- include('partials/pagination', { base: url(fmt.threadPath(thread)) }) %>

    <section class="reply-box card" id="reply">
      <% if (canReply) { %>
        <h2>Reply to this thread</h2>
        <form method="post" action="<%= url('/threads/' + thread.id + '/reply') %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <%- include('partials/editor', { id: 'reply-body', rows: 6, placeholder: 'Share your answer, a follow-up question or what worked for you…' }) %>
          <div class="form-actions">
            <button class="btn btn--primary" type="submit"><%- icon('reply', 16) %> Post reply</button>
            <% if (!isStaff) { %><span class="muted small"><%- icon('shield', 14) %> The <%= supportTeamName %> team follows this thread.</span><% } %>
          </div>
        </form>
      <% } else if (thread.is_locked) { %>
        <p class="muted"><%- icon('lock', 16) %> This thread is locked. Start a new thread if you need more help.</p>
      <% } else { %>
        <div class="join-prompt">
          <div>
            <h2>Join the conversation</h2>
            <p class="muted">You need an account to reply. It's free and takes 30 seconds.</p>
          </div>
          <div class="join-actions">
            <a class="btn btn--primary" href="<%= url('/register?next=' + encodeURIComponent(url(fmt.threadPath(thread)))) %>">Create account</a>
            <a class="btn btn--ghost" href="<%= url('/login?next=' + encodeURIComponent(url(fmt.threadPath(thread)))) %>">Log in</a>
          </div>
        </div>
      <% } %>
    </section>
  </div>

  <aside class="sidebar">
    <% if (related.length) { %>
    <section class="card">
      <h2 class="card-title">Similar threads</h2>
      <ul class="mini-list mini-list--plain">
        <% related.forEach(t => { %>
        <li><a href="<%= url(fmt.threadPath(t)) %>"><%= t.title %></a>
          <span class="muted small"><%= t.reply_count %> <%= t.reply_count === 1 ? 'reply' : 'replies' %><%= t.is_solved ? ' · Solved' : '' %></span></li>
        <% }) %>
      </ul>
    </section>
    <% } %>
  </aside>
</div>
<%- include('partials/footer') %>
