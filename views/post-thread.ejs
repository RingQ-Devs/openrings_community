<%- include('partials/header') %>
<div class="narrow">
  <div class="page-head"><div><h1>Ask the community</h1>
  <p class="muted">Clear questions get the best answers. The <%= supportTeamName %> team replies in the thread, and other members can join in.</p></div></div>
  <% if (errors.length) { %><div class="alert alert--error"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
  <form class="card form" method="post" action="<%= url('/post-thread') %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website_url" tabindex="-1" autocomplete="off"></label></div>
    <label class="field">
      <span>Forum</span>
      <select name="forum_id" required>
        <option value="">Choose where your question fits…</option>
        <% let cat = null; forums.forEach(f => { if (f.category_title !== cat) { if (cat !== null) { %></optgroup><% } cat = f.category_title; %><optgroup label="<%= cat %>"><% } %>
          <option value="<%= f.id %>" <%= Number(values.forum_id) === f.id ? 'selected' : '' %>><%= f.title %></option>
        <% }); if (cat !== null) { %></optgroup><% } %>
      </select>
    </label>
    <label class="field">
      <span>Title</span>
      <input type="text" name="title" value="<%= values.title || '' %>" required minlength="8" maxlength="150"
        placeholder="e.g. One-way audio on remote extensions behind NAT">
    </label>
    <div class="field">
      <span>Your question</span>
      <%- include('partials/editor', { id: 'thread-body', rows: 10, value: values.body || '', placeholder: 'Describe what you are trying to do, what you have tried, and any error messages. Include your OpenRings version, phones and SIP provider if relevant.' }) %>
    </div>
    <div class="tips muted small">
      <strong>Tips:</strong> one problem per thread · paste logs in ``` code blocks ``` · remove passwords, public IPs and phone numbers you don't want to share.
    </div>
    <div class="form-actions"><button class="btn btn--primary" type="submit">Post question</button></div>
  </form>
</div>
<%- include('partials/footer') %>
