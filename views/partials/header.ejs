<%- include('head') %>
<%
  const inAdmin = currentPath.startsWith('/admin');
  const inInbox = currentPath.startsWith('/support');
  // The one "Ask a question" button: pre-selects the forum when you are inside one.
  const askForum = (typeof forum !== 'undefined' && forum && forum.slug) ? forum.slug : null;
  const askUrl = url('/post-thread' + (askForum ? '?forum=' + askForum : ''));
  const navLink = (href, label, active, extra = '') => `<a href="${href}"${active ? ' aria-current="page"' : ''}>${label}${extra}</a>`;
%>
<header class="nav" id="nav">
  <div class="container nav-inner">
    <a class="brand" href="<%= url('/') %>" aria-label="<%= site.name %> home">
      <%- h.brandMark(28) %>
      <span>Open<b>Rings</b> <span class="brand-sub">Community</span></span>
    </a>
    <div class="nav-collapse">
      <nav class="nav-links" aria-label="Community">
        <%- navLink(url('/'), 'Forums', currentPath === '/' || currentPath.startsWith('/forums') || currentPath.startsWith('/threads')) %>
        <%- navLink(url('/whats-new'), "What's new", currentPath.startsWith('/whats-new')) %>
        <%- navLink(url('/members/'), 'Members', currentPath.startsWith('/members')) %>
        <% if (isStaff) { %><a class="show-menu" href="<%= url('/support/inbox') %>"<%- inInbox ? ' aria-current="page"' : '' %>>Support inbox<% if (inboxCount) { %> <span class="count"><%= inboxCount %></span><% } %></a><% } %>
        <% if (isAdmin) { %><a class="show-menu" href="<%= url('/admin') %>"<%- inAdmin ? ' aria-current="page"' : '' %>>Admin</a><% } %>
        <% if (!user) { %>
          <a class="show-xs" href="<%= url('/login') %>">Log in</a>
          <a class="show-xs" href="<%= url('/register') %>">Join</a>
        <% } %>
      </nav>
      <% if (currentPath !== '/') { %>
      <form class="nav-search" action="<%= url('/search') %>" method="get" role="search">
        <label class="sr-only" for="header-q">Search the community</label>
        <%- icon('search', 16) %>
        <input id="header-q" type="search" name="q" placeholder="Search questions…" autocomplete="off">
      </form>
      <% } %>
    </div>
    <div class="nav-actions">
      <a class="btn btn--primary btn--sm ask-btn" href="<%= askUrl %>"><%- icon('plus', 16) %><span class="ask-long">Ask a question</span><span class="ask-short">Ask</span></a>
      <a class="icon-btn hide-menu<%= currentPath.startsWith('/search') ? ' is-active' : '' %>" href="<%= url('/search') %>" aria-label="Search"><%- icon('search', 18) %></a>
      <% if (isStaff) { %><a class="icon-btn icon-btn--badge hide-menu<%= inInbox ? ' is-active' : '' %>" href="<%= url('/support/inbox') %>" aria-label="Support inbox<%= inboxCount ? ', ' + inboxCount + ' waiting' : '' %>" title="Support inbox"><%- icon('inbox', 18) %><% if (inboxCount) { %><span class="count"><%= inboxCount %></span><% } %></a><% } %>
      <button class="icon-btn hide-xs" id="theme" type="button" aria-label="Switch light or dark mode">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <% if (user) { %>
        <details class="user-menu">
          <summary aria-label="Account menu" title="<%= user.username %>"><%- h.avatar(user, 32) %></summary>
          <div class="user-menu-panel">
            <div class="user-menu-head"><%- h.avatar(user, 28) %><strong><%= user.username %></strong></div>
            <a href="<%= url(fmt.memberPath(user)) %>">Your profile</a>
            <a href="<%= url('/account') %>">Account settings</a>
            <% if (isStaff) { %><a href="<%= url('/support/inbox') %>">Support inbox<% if (inboxCount) { %> (<%= inboxCount %>)<% } %></a><% } %>
            <% if (isAdmin) { %><a href="<%= url('/admin') %>">Admin panel</a><% } %>
            <form action="<%= url('/logout') %>" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="link-button">Log out</button>
            </form>
          </div>
        </details>
      <% } else { %>
        <a class="btn btn--ghost btn--sm hide-xs" href="<%= url('/login') %>">Log in</a>
        <a class="btn btn--ghost btn--sm hide-xs" href="<%= url('/register') %>">Join</a>
      <% } %>
      <button class="icon-btn menu-btn" id="menu" type="button" aria-label="Open menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>
  </div>
</header>
<% if (announcement) { %>
<div class="announcement"><div class="container"><%- icon('megaphone', 16) %> <%= announcement %></div></div>
<% } %>
<main id="main" class="container page">
<% if (flash) { %>
  <div class="alert alert--<%= flash.type %>" role="status"><%= flash.message %></div>
<% } %>
