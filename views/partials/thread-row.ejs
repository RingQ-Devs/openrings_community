<li class="thread-row<%= t.is_pinned ? ' is-pinned' : '' %>">
  <%- h.avatar({ username: t.author_username, role: t.author_role }, 40) %>
  <div class="thread-main">
    <div class="thread-title">
      <% if (t.is_pinned) { %><span class="flag flag--pin" title="Pinned"><%- icon('pin', 14) %></span><% } %>
      <% if (t.is_locked) { %><span class="flag flag--lock" title="Locked"><%- icon('lock', 14) %></span><% } %>
      <% if (t.is_solved) { %><span class="label label--solved"><%- icon('check', 12) %> Solved</span><% } %>
      <a href="<%= url(fmt.threadPath(t)) %>"><%= t.title %></a>
    </div>
    <div class="thread-meta muted small">
      <%- h.userLink(url(''), { username: t.author_username, role: t.author_role }) %>
      <% if (t.author_role === 'persona' && disclosePersonas) { %><%- badges({ role: 'persona' }) %><% } %>
      <% if (t.last_role === 'support' || t.last_role === 'admin') { %><span class="badge badge--staff badge--sm">Answered by <%= supportTeamName %></span><% } %>
      · <time datetime="<%= t.created_at %>"><%= fmt.formatDate(t.created_at) %></time>
      <% if (typeof showForum !== 'undefined' && showForum) { %> · <a class="muted" href="<%= url('/forums/' + t.forum_slug + '/') %>"><%= t.forum_title %></a><% } %>
    </div>
  </div>
  <dl class="thread-stats">
    <div><dt>Replies</dt><dd><%= fmt.compactNumber(t.reply_count) %></dd></div>
    <div><dt>Views</dt><dd><%= fmt.compactNumber(t.view_count) %></dd></div>
  </dl>
  <div class="thread-last">
    <time class="small" datetime="<%= t.last_post_at %>" title="<%= fmt.formatDateTime(t.last_post_at) %>"><%= fmt.timeAgo(t.last_post_at) %></time>
    <span class="small"><%- h.userLink(url(''), { username: t.last_username, role: t.last_role }) %></span>
  </div>
</li>
