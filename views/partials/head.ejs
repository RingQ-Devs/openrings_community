<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const fullTitle = meta.title === site.name ? site.name : meta.title + ' | ' + site.name; %>
  <title><%= fullTitle %></title>
  <meta name="description" content="<%= meta.description %>">
  <% if (meta.noindex) { %><meta name="robots" content="noindex, follow"><% } %>
  <% if (meta.canonical) { %><link rel="canonical" href="<%= meta.canonical %>"><% } %>
  <meta property="og:site_name" content="<%= site.productName %>">
  <meta property="og:title" content="<%= meta.title %>">
  <meta property="og:description" content="<%= meta.description %>">
  <meta property="og:type" content="<%= meta.ogType || 'website' %>">
  <% if (meta.canonical) { %><meta property="og:url" content="<%= meta.canonical %>"><% } %>
  <meta name="twitter:card" content="summary">
  <meta name="theme-color" content="#070b14">
  <script src="<%= url('/static/js/theme.js') %>"></script>
  <link rel="icon" href="<%= url('/static/img/favicon.svg') %>" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="<%= url('/static/css/style.css') %>">
  <% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
  <script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script>
  <% } %>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
