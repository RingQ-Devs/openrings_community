<% if (pages > 1) {
  const link = (p) => base + (p > 1 ? (base.includes('?') ? '&' : '?') + 'page=' + p : '');
  const nums = [];
  for (let p = 1; p <= pages; p++) if (p === 1 || p === pages || Math.abs(p - page) <= 2) nums.push(p);
%>
<nav class="pagination" aria-label="Pagination">
  <% if (page > 1) { %><a href="<%= link(page - 1) %>" rel="prev">‹ Prev</a><% } %>
  <% let last = 0; nums.forEach(p => { if (p - last > 1) { %><span class="gap">…</span><% } last = p; %>
    <% if (p === page) { %><span class="current" aria-current="page"><%= p %></span><% } else { %><a href="<%= link(p) %>"><%= p %></a><% } %>
  <% }) %>
  <% if (page < pages) { %><a href="<%= link(page + 1) %>" rel="next">Next ›</a><% } %>
</nav>
<% } %>
