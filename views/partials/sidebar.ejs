<aside class="sidebar">
  <% if (typeof sidebar !== 'undefined' && sidebar) { %>
  <section class="card">
    <h2 class="card-title">Latest activity</h2>
    <ul class="mini-list">
      <% sidebar.latest.forEach(t => { %>
      <li>
        <%- h.avatar({ username: t.last_username, role: t.last_role }, 28) %>
        <div>
          <a href="<%= url(fmt.threadPath(t)) %>"><%= t.title %></a>
          <span class="muted small"><%= t.last_username %> · <time datetime="<%= t.last_post_at %>" title="<%= fmt.formatDateTime(t.last_post_at) %>"><%= fmt.timeAgo(t.last_post_at) %></time></span>
        </div>
      </li>
      <% }) %>
      <% if (!sidebar.latest.length) { %><li class="muted">No posts yet. Be the first!</li><% } %>
    </ul>
  </section>
  <section class="card">
    <h2 class="card-title">Community stats</h2>
    <dl class="stats-list">
      <div><dt>Threads</dt><dd><%= sidebar.stats.threads.toLocaleString('en-US') %></dd></div>
      <div><dt>Messages</dt><dd><%= sidebar.stats.posts.toLocaleString('en-US') %></dd></div>
      <div><dt>Solved</dt><dd><%= sidebar.stats.solved.toLocaleString('en-US') %></dd></div>
      <div><dt>Members</dt><dd><%= sidebar.stats.members.toLocaleString('en-US') %></dd></div>
      <% if (sidebar.newest) { %><div><dt>Latest member</dt><dd><%- h.userLink(url(''), sidebar.newest) %></dd></div><% } %>
    </dl>
  </section>
  <% if (sidebar.online.length) { %>
  <section class="card">
    <h2 class="card-title">Online now</h2>
    <p class="online-list">
      <% sidebar.online.forEach((m, i) => { %><%- h.userLink(url(''), m) %><%= i < sidebar.online.length - 1 ? ', ' : '' %><% }) %>
    </p>
  </section>
  <% } %>
  <% } %>
</aside>
