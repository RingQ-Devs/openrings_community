<%- include('partials/header') %>
<div class="auth">
  <form class="card form auth-card" method="post" action="<%= url('/register') %>">
    <h1>Join the community</h1>
    <p class="muted">Ask questions, share what you've built with <%= site.productName %> and help other admins.</p>
    <% if (errors.length) { %><div class="alert alert--error"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website_url" tabindex="-1" autocomplete="off"></label></div>
    <label class="field"><span>Username</span><input type="text" name="username" value="<%= values.username || '' %>" required minlength="3" maxlength="24" pattern="[A-Za-z0-9][A-Za-z0-9_.\-]{2,23}" autocomplete="username"><small class="muted">Shown publicly. Letters, numbers, dot, dash, underscore.</small></label>
    <label class="field"><span>Email</span><input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email"><small class="muted">Never shown publicly.</small></label>
    <label class="field"><span>Password</span><input type="password" name="password" required minlength="8" autocomplete="new-password"><small class="muted">At least 8 characters.</small></label>
    <label class="check"><input type="checkbox" name="agree" value="1" required> I agree to the <a href="<%= url('/rules') %>" target="_blank">community rules</a></label>
    <button class="btn btn--primary btn--block" type="submit">Create account</button>
    <p class="muted small center">Already a member? <a href="<%= url('/login') %>">Log in</a></p>
  </form>
</div>
<%- include('partials/footer') %>
