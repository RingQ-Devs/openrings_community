<%- include('partials/header') %>
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="<%= url('/') %>">Forums</a> <span>›</span> <span><%= category.title %></span>
</nav>
<div class="page-head">
  <div>
    <h1><%= forum.title %></h1>
    <p class="muted"><%= forum.description %></p>
  </div>
</div>
<div class="layout">
  <div class="content">
    <section class="block">
      <% if (threads.length) { %>
      <ul class="thread-list">
        <% threads.forEach(t => { %><%- include('partials/thread-row', { t, showForum: false }) %><% }) %>
      </ul>
      <% } else { %>
      <div class="empty">
        <p>There are no threads in this forum yet. Use <strong>Ask a question</strong> at the top to start one.</p>
      </div>
      <% } %>
    </section>
    <%- include('partials/pagination', { base: url('/forums/' + forum.slug + '/') }) %>
  </div>
  <%- include('partials/sidebar') %>
</div>
<%- include('partials/footer') %>
