<%- include('partials/header') %>
<section class="hero">
  <div class="hero-text">
    <p class="eyebrow"><span class="dot"></span> <%= site.productName %> Community</p>
    <h1>Questions, answers and fixes for <span class="grad"><%= site.productName %></span></h1>
    <p class="hero-sub">Ask about installing, configuring and running <%= site.productName %>. The <%= supportTeamName %> team answers in the threads, so every solution stays here for the next person to find.</p>
    <form class="hero-search" action="<%= url('/search') %>" method="get" role="search">
      <label class="sr-only" for="hero-q">Search</label>
      <%- icon('search', 18) %>
      <input id="hero-q" type="search" name="q" placeholder="Search SIP trunks, dialplan, queues, WebRTC…">
      <button class="btn btn--primary btn--sm" type="submit">Search</button>
    </form>
  </div>
</section>

<div class="layout">
  <div class="content">
    <% categories.forEach(cat => { %>
    <section class="block" aria-labelledby="cat-<%= cat.id %>">
      <header class="block-header">
        <h2 id="cat-<%= cat.id %>"><%= cat.title %></h2>
        <% if (cat.description) { %><p><%= cat.description %></p><% } %>
      </header>
      <ul class="node-list">
        <% cat.forums.forEach(f => { %>
        <li class="node">
          <span class="node-icon"><%- icon(f.icon, 22) %></span>
          <div class="node-main">
            <h3><a href="<%= url('/forums/' + f.slug + '/') %>"><%= f.title %></a></h3>
            <p class="muted small"><%= f.description %></p>
          </div>
          <dl class="node-stats">
            <div><dt>Threads</dt><dd><%= fmt.compactNumber(f.thread_count) %></dd></div>
            <div><dt>Messages</dt><dd><%= fmt.compactNumber(f.post_count) %></dd></div>
          </dl>
          <div class="node-last">
            <% if (f.last_thread_id) { %>
              <%- h.avatar({ username: f.last_username, role: f.last_role }, 32) %>
              <div>
                <a class="node-last-title" href="<%= url('/threads/' + f.last_thread_slug + '.' + f.last_thread_id + '/') %>"><%= f.last_thread_title %></a>
                <span class="muted small"><time datetime="<%= f.last_post_at %>"><%= fmt.timeAgo(f.last_post_at) %></time> · <%= f.last_username %></span>
              </div>
            <% } else { %>
              <span class="muted small">No threads yet</span>
            <% } %>
          </div>
        </li>
        <% }) %>
      </ul>
    </section>
    <% }) %>
  </div>
  <%- include('partials/sidebar') %>
</div>
<%- include('partials/footer') %>
